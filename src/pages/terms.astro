---
import Layout from '../layouts/Layout.astro';
import { CONTACT_EMAIL, DEVELOPER, LEGAL_EFFECTIVE } from '../config';
---
<Layout title="Terms of Use — Catographer" description="Terms of Use (EULA) for the Catographer iOS and watchOS applications." path="terms/">
  <article class="px-4 pt-14 pb-10">
    <div class="cg-card mx-auto max-w-3xl p-8 md:p-12 prose-legal">
      <h1 class="text-3xl md:text-4xl font-semibold"><span data-lang-en>Terms of Use (EULA) for Catographer</span><span data-lang-ru>Условия использования (EULA) Catographer</span></h1>
