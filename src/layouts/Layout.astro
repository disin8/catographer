---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { abs, SITE_URL, APP_STORE_URL } from '../config';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}
const {
  title = 'Catographer — a private walking diary on a map',
  description = 'Catographer turns every walk into a quiet line on your own map. Photos, notes and moods pinned to the route. No account, no ads, no analytics.',
  path = '',
  noindex = false,
} = Astro.props;
const canonical = abs(path);
const ogImage = abs('assets/images/app-icon.png');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Catographer',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'iOS 18.0 or later',
  description,
  url: SITE_URL,
  image: ogImage,
  offers: undefined,
  author: { '@type': 'Person', name: 'Dmitry Sinkevich' },
  ...(APP_STORE_URL ? { downloadUrl: APP_STORE_URL } : {}),
};
---

<!doctype html>
<html lang="en" class="scroll-smooth no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#94c2eb" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}assets/images/app-icon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}assets/images/app-icon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Catographer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      (function () {
        try {
          document.documentElement.classList.remove('no-js');
          var t = localStorage.getItem('theme');
          var dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
          var l = localStorage.getItem('lang') || ((navigator.language || 'en').toLowerCase().indexOf('ru') === 0 ? 'ru' : 'en');
          document.documentElement.lang = l;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="cg-bg" aria-hidden="true"><div class="cg-blob a"></div><div class="cg-blob b"></div><div class="cg-blob c"></div></div>
    <Header />
    <main id="main"><slot /></main>
    <Footer />

    <script is:inline>
      function setLanguage(l) {
        document.documentElement.lang = l;
        try { localStorage.setItem('lang', l); } catch (e) {}
        document.querySelectorAll('[data-lang-btn]').forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.getAttribute('data-lang-btn') === l));
        });
      }
      function toggleTheme() {
        var d = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', d ? 'dark' : 'light'); } catch (e) {}
        document.querySelectorAll('[data-theme-btn]').forEach(function (b) { b.setAttribute('aria-pressed', String(d)); });
      }
      document.addEventListener('DOMContentLoaded', function () {
        setLanguage(document.documentElement.lang === 'ru' ? 'ru' : 'en');
        var d = document.documentElement.classList.contains('dark');
        document.querySelectorAll('[data-theme-btn]').forEach(function (b) { b.setAttribute('aria-pressed', String(d)); b.addEventListener('click', toggleTheme); });
        document.querySelectorAll('[data-lang-btn]').forEach(function (b) { b.addEventListener('click', function () { setLanguage(b.getAttribute('data-lang-btn')); }); });
      });
    </script>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('[data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('is-visible'); }); }
        else {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); } });
          }, { threshold: 0.12 });
          els.forEach(function (e) { io.observe(e); });
        }
        if (!reduce && window.matchMedia('(hover: hover)').matches) {
          document.querySelectorAll('[data-tilt]').forEach(function (host) {
            var inner = host.querySelector('.tilt-inner'); if (!inner) return;
            host.addEventListener('mousemove', function (ev) {
              var r = host.getBoundingClientRect();
              var x = (ev.clientX - r.left) / r.width - 0.5, y = (ev.clientY - r.top) / r.height - 0.5;
              inner.style.transform = 'perspective(900px) rotateY(' + (x * 10) + 'deg) rotateX(' + (-y * 8) + 'deg)';
            });
            host.addEventListener('mouseleave', function () { inner.style.transform = ''; });
          });
        }
      });
    </script>
  </body>
</html>
