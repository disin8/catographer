---
const base = import.meta.env.BASE_URL;
const icons = [
  { id: 'dawn', src: 'dawn.png', en: 'Dawn', ru: 'Рассвет' },
  { id: 'night', src: 'night.png', en: 'Night', ru: 'Ночь' },
  { id: 'scout', src: 'scout.png', en: 'Scout', ru: 'Скаут' },
  { id: 'trail', src: 'trail.png', en: 'Trail', ru: 'Тропа' },
];
---
<section class="px-4 py-16">
  <div class="mx-auto max-w-4xl text-center">
    <h2 class="text-3xl md:text-4xl font-semibold"><span data-lang-en>Pick an icon that fits the walk</span><span data-lang-ru>Иконка под настроение прогулки</span></h2>
    <p class="mt-4 text-[var(--ink-soft)]"><span data-lang-en>Dawn, Night, Scout or Trail, each with a light and dark look.</span><span data-lang-ru>Рассвет, Ночь, Скаут или Тропа. У каждой есть светлый и тёмный вариант.</span></p>
    <ul class="mt-10 flex flex-wrap justify-center gap-8">
      {icons.map((i) => (
        <li class="text-center transition-transform hover:-translate-y-1 hover:rotate-3" data-reveal>
          <img src={`${base}assets/images/${i.src}`} alt={`${i.en} app icon`} width="96" height="96" loading="lazy" class="rounded-[22px] shadow-lg" />
          <p class="mt-3 text-sm font-semibold"><span data-lang-en>{i.en}</span><span data-lang-ru>{i.ru}</span></p>
        </li>
      ))}
    </ul>
  </div>
</section>
