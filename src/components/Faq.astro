---
export const faqs = [
  { q: ['What is Catographer for?', 'Для чего нужен Catographer?'], a: ['It is a walking diary on a map. You record routes, pin moments to them, and watch explored areas grow over months and years. It is not a step counter or calorie app.', 'Это дневник прогулок на карте. Вы записываете маршруты, закрепляете на них моменты и со временем видите, какие районы уже обошли. Это не счётчик шагов и не приложение про калории.'] },
  { q: ['Do I need an account?', 'Нужен ли аккаунт?'], a: ['No. There is nothing to sign up for. Walks stay on the device unless you turn on optional iCloud sync.', 'Нет. Регистрироваться некуда. Прогулки остаются на устройстве, пока вы сами не включите синхронизацию iCloud.'] },
  { q: ['Does it work offline?', 'Работает ли без интернета?'], a: ['Recording uses GPS and works without a network. Fresh map tiles from Apple Maps may need a connection the first time you open a new area.', 'Запись идёт по GPS и работает без сети. Новые тайлы Apple Maps могут понадобиться при первом открытии незнакомого района.'] },
  { q: ['Apple Watch and Apple Health?', 'Apple Watch и Apple Health?'], a: ['You can record on Apple Watch. Walks can export to Apple Health as workouts with routes, or import from Health as copies in the diary.', 'Запись доступна с Apple Watch. Прогулки можно отправить в Apple Health как тренировки с маршрутом или импортировать из Health копиями в дневник.'] },
  { q: ['Can I sync or back up?', 'Синхронизация и бэкап?'], a: ['Optional iCloud sync covers walks, notes and places (photos stay on device). Backups and GPX import/export are built in.', 'Опциональный iCloud синхронизирует прогулки, заметки и места (фото остаются на устройстве). Резервные копии и GPX уже внутри.'] },
  { q: ['Does it track me when I am not recording?', 'Следит ли оно, когда я не записываю?'], a: ['No. Location runs only during a recording. Optional walk suggestions only ask if you want to start one.', 'Нет. Геолокация работает только во время записи. Опциональные подсказки лишь спрашивают, не начать ли прогулку.'] },
];
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q[0], acceptedAnswer: { '@type': 'Answer', text: f.a[0] } })) };
---
<section id="faq" class="px-4 py-16">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="mx-auto max-w-3xl">
    <h2 class="text-3xl md:text-4xl font-semibold text-center"><span data-lang-en>Questions</span><span data-lang-ru>Вопросы</span></h2>
    <div class="mt-10 space-y-3">
      {faqs.map((f) => (
        <details class="cg-card group p-5" data-reveal>
          <summary class="cursor-pointer list-none font-semibold flex justify-between gap-4">
            <span><span data-lang-en>{f.q[0]}</span><span data-lang-ru>{f.q[1]}</span></span>
            <span aria-hidden="true" class="transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-[var(--ink-soft)] leading-relaxed"><span data-lang-en>{f.a[0]}</span><span data-lang-ru>{f.a[1]}</span></p>
        </details>
      ))}
    </div>
  </div>
</section>
