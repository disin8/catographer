---
import { url, CONTACT_EMAIL, DEVELOPER } from '../config';
const year = new Date().getFullYear();
---
<footer class="mt-24 px-4 pb-10">
  <div class="cg-card mx-auto max-w-5xl p-8 flex flex-col md:flex-row gap-8 md:items-center justify-between">
    <div class="flex items-center gap-3">
      <img src={`${import.meta.env.BASE_URL}assets/images/app-icon.png`} alt="" width="44" height="44" class="rounded-[12px]" />
      <div>
        <p class="font-display font-semibold">Catographer</p>
        <p class="text-sm text-[var(--ink-soft)]"><span data-lang-en>Your walks, on your own map.</span><span data-lang-ru>Ваши прогулки — на вашей карте.</span></p>
      </div>
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold" aria-label="Footer">
      <a href={url('privacy/')}><span data-lang-en>Privacy Policy</span><span data-lang-ru>Конфиденциальность</span></a>
      <a href={url('terms/')}><span data-lang-en>Terms of Use</span><span data-lang-ru>Условия использования</span></a>
      <a href={url('support/')}><span data-lang-en>Support</span><span data-lang-ru>Поддержка</span></a>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </nav>
  </div>
  <p class="mx-auto max-w-5xl mt-6 text-xs text-center text-[var(--ink-soft)]">
    © {year} {DEVELOPER}. Apple, iPhone, Apple Watch, Face ID and App Store are trademarks of Apple Inc.
  </p>
</footer>
