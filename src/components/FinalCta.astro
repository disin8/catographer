---
import DownloadButton from './DownloadButton.astro';
---
<section class="px-4 py-16">
  <div class="cg-card mx-auto max-w-3xl p-10 text-center" data-reveal>
    <h2 class="text-3xl md:text-4xl font-semibold"><span data-lang-en>Start your first line.</span><span data-lang-ru>Проведите первую линию.</span></h2>
    <p class="mt-3 text-[var(--ink-soft)]"><span data-lang-en>Take a walk. Catographer will remember the way.</span><span data-lang-ru>Выйдите на прогулку. Catographer запомнит путь.</span></p>
    <div class="mt-7 flex justify-center"><DownloadButton /></div>
  </div>
</section>
