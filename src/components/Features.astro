---
import Icon from './Icon.astro';
const items = [
  { icon: 'map', en: ['Record the route', 'Start Walk, Hike or Run and keep walking. Catographer tracks GPS, pauses when you stop, and saves battery on long days out.'], ru: ['Запись маршрута', 'Выберите Прогулка, Поход или Бег и идите. Catographer пишет GPS, ставит паузу на остановках и бережёт батарею в долгих выходах.'] },
  { icon: 'image', en: ['Moments on the line', 'Drop a photo, note, mood or tag on the exact spot. Share the walk later as a card or a poster.'], ru: ['Моменты на линии', 'Фото, заметка, настроение или тег прямо в точке на маршруте. Потом прогулку можно отправить карточкой или постером.'] },
  { icon: 'earth', en: ['A map of where you have been', 'Month and year views stack every route, show explored neighbourhoods, and make a year poster you can keep.'], ru: ['Карта мест, где вы были', 'Вид за месяц и за год собирает все маршруты, показывает обойдённые районы и собирает годовой постер.'] },
  { icon: 'compass', en: ['Find any past walk', 'Search by word, date range or area. Catographer also marks the stops and loops you repeat.'], ru: ['Найти любую прошлую прогулку', 'Поиск по слову, датам или району. Частые остановки и любимые петли отмечаются сами.'] },
  { icon: 'bolt', en: ['Phone, Watch or Siri', 'Start from the iPhone, Apple Watch or Dynamic Island. Or say "Start a walk" to Siri.'], ru: ['Телефон, Watch или Siri', 'Старт с iPhone, Apple Watch или Dynamic Island. Или скажите Siri: «Начать прогулку».'] },
  { icon: 'shield-check', en: ['Optional Apple Health', 'Export a walk as a workout with the route, or import ones you already logged.'], ru: ['Apple Health по желанию', 'Экспорт прогулки как тренировки с маршрутом или импорт уже записанных.'] },
];
---
<section id="features" class="px-4 py-16">
  <div class="mx-auto max-w-5xl">
    <h2 class="text-3xl md:text-4xl font-semibold text-center"><span data-lang-en>What Catographer does with a walk</span><span data-lang-ru>Что Catographer делает с прогулкой</span></h2>
    <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {items.map((i) => (
        <article class="cg-card lift p-6" data-reveal>
          <span class="w-11 h-11 grid place-items-center rounded-2xl bg-[var(--lilac)] text-[#2e3d52]"><Icon name={i.icon} class="w-5 h-5" /></span>
          <h3 class="mt-4 text-lg font-semibold"><span data-lang-en>{i.en[0]}</span><span data-lang-ru>{i.ru[0]}</span></h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--ink-soft)]"><span data-lang-en>{i.en[1]}</span><span data-lang-ru>{i.ru[1]}</span></p>
        </article>
      ))}
    </div>
  </div>
</section>
